-- Create user --
    --> permit from securityConfig and custom filter (Bypass Auth)
    --> one-to-many mapping (Users and Api)
    -->  UserController.java file

    postman request POST 'http://localhost:8080/user/addUser' \
      --header 'Content-Type: application/json' \
      --body '{
        "username": "sonu",
        "password": "mangal",
        "userKey": "smangal",
        "role": "ADMIN",
        "apiEntities": [
            {
                "apiName": "login",
                "rateLimit": 5
            },
            {
                "apiName": "history",
                "rateLimit": 4
            }
        ]
    }'

-- Get User --
        --> permit from securityConfig and custom filter (Bypass Auth)
        --> one-to-many mapping (Users and Api)
        -->  UserController.java file

    postman request 'http://localhost:8080/user/getUsers'

----------------------------------------------------------------
------- Rate Limit Filter Level -----
    --> Authenticate API
    -->  RateLimitController.java file
    --> SecurityConfig -> UserKeyAuthenticationFilter (Get Limit from DB) -> RateLimitFilter -> RateLimitService
        -> Controller

CLIENT REQUEST
      |
      v
Spring Security Filter Chain
      |
      v
UserKeyAuthenticationFilter
      |
      |-- Read X-USER-KEY
      |
      |-- Find user in USER_DETAIL
      |
      |-- User found?
      |      |
      |      +-- NO  --> 401 Unauthorized
      |      |
      |      +-- YES
      |             |
      |             v
      |        Create Authentication
      |             |
      |             v
      |        Store in SecurityContext
      |
      v
RateLimitFilter
      |
      |-- Get authenticated user
      |
      |-- Identify API
      |
      |-- Call RateLimitService
      |
      v
RateLimitService
      |
      |-- Create bucket key
      |      userKey + API name
      |
      |-- Check ConcurrentHashMap
      |      |
      |      +-- Bucket exists
      |      |      |
      |      |      +-- Use existing Bucket4j bucket
      |      |
      |      +-- Bucket does not exist
      |             |
      |             +-- Get rate limit from DB
      |             |
      |             +-- Create Bucket4j bucket
      |             |
      |             +-- Put bucket in ConcurrentHashMap
      |
      |-- Try consume 1 token
      |
      +---- Allowed ----> Controller
      |
      +---- Rejected ---> 429 Too Many Requests

API:
    postman request 'http://localhost:8080/rateLimit/history' \
      --header 'X-USER-KEY: smangal'


